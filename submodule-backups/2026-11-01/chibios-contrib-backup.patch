---
 os/hal/ports/SN32/LLD/SN32F24x/USB/hal_usb_lld.h | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/os/hal/ports/SN32/LLD/SN32F24x/USB/hal_usb_lld.h b/os/hal/ports/SN32/LLD/SN32F24x/USB/hal_usb_lld.h
index 72ea3ee4..630f3d5c 100644
--- a/os/hal/ports/SN32/LLD/SN32F24x/USB/hal_usb_lld.h
+++ b/os/hal/ports/SN32/LLD/SN32F24x/USB/hal_usb_lld.h
@@ -348,14 +348,14 @@ struct USBDriver {
  *
  * @api
  */
-#define usb_lld_connect_bus(usbp)
+#define usb_lld_connect_bus(usbp)    (SN_USB->CFG |= (1U << 29))
 
 /**
  * @brief   Disconnect the USB device.
  *
  * @api
  */
-#define usb_lld_disconnect_bus(usbp)
+#define usb_lld_disconnect_bus(usbp) (SN_USB->CFG &= ~(1U << 29))
 
 /**
  * @brief   Start of host wake-up procedure.
